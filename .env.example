TIKTOK_USER=soyastrolia
EULER_API_KEY=
BACKEND_URL=http://127.0.0.1:8000
# Clave de la consola de Anthropic. Sin ella el backend usa el generador de prueba.
ANTHROPIC_API_KEY=
# Opcional: otro modelo (por defecto claude-sonnet-5-5)
# ANTHROPIC_MODEL_RAPIDO=
# ANTHROPIC_MODEL=
# Minutos entre un boost de likes y el siguiente (0 = solo a pedido)
# BOOST_CADA_MIN=10
# Minutos entre recordatorios de la pregunta gratis (0 = nunca)
# AVISO_GRATIS_MIN=5
# Segundos mínimos entre saludos a quienes entran al live (0 = no saludar)
# BIENVENIDA_CADA_SEG=180
# 0 = no usar la IA para los mensajes dudosos (deciden solo las reglas)
# CLASIFICADOR_IA=1
# Voz: 0 la apaga. Por defecto usa voz/es_MX-claude-high.onnx (python -m tools.descargar_voz)
# VOZ=1
# VOZ_MODELO=voz/es_MX-claude-high.onnx
# VOZ_HABLANTE=1        # solo modelos con varias voces (es_ES-sharvard-medium: 1 = mujer)
# Segundos de silencio antes de que la voz llene el rato con un tip, la carta del momento o el cielo (0 = callada)
# RELLENO_SEG=3
# 0 = no pedirle tips nuevos a la IA (salen solo los fijos de backend/frases.py)
# TIPS_IA=1
# SIN_LIVE_MIN=3        # minutos sin eventos del live tras los cuales la voz deja de rellenar (0 = no vigilar)
